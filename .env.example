# Copy this file to ".env" and change the values if you want.

# Which Ollama model to use. It must be downloaded first: `ollama pull llama3.2`
OLLAMA_MODEL=llama3.2

# Optional: where Ollama is running (this is the default).
# OLLAMA_HOST=http://localhost:11434

# Optional: max number of characters from the document sent to the model.
# Small local models have limited "memory" (context window), so keep this modest.
# MAX_INPUT_CHARS=12000
